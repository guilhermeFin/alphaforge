# AlphaForge environment variables.
# Copy to `.env` (which is gitignored) and fill in. NEVER commit real secrets —
# the security workflow scans every push for leaked keys and will fail the build.

# --- LLM signal extraction (optional; offline paths work without it) ---
ANTHROPIC_API_KEY=

# --- paid point-in-time fundamental data (optional, key-gated) ---
NASDAQ_DATA_LINK_API_KEY=
SIMFIN_API_KEY=

# --- app / API wiring ---
ALPHAFORGE_API=http://127.0.0.1:8000

# --- security (set in production / behind HTTPS) ---
# ALPHAFORGE_ENV=production                                  # enables Secure cookies + HSTS
# ALPHAFORGE_CORS_ORIGINS=https://app.alphaforge.example     # comma-separated allowed browser origins
# ALPHAFORGE_RATE_LIMIT=120                                  # requests/60s/IP (in-process backstop only)
# ALPHAFORGE_MAX_BODY_BYTES=262144                           # max request body in bytes (default 256 KiB)

# --- accounts / data layer (optional; OFF unless enabled) ---
# ALPHAFORGE_ACCOUNTS=1                                      # turn on the accounts/auth surface
# ALPHAFORGE_DB_PATH=alphaforge.db                           # SQLite path (also enables accounts if set)
# ALPHAFORGE_DATA_KEY=                                       # REQUIRED in prod: master key for field
#                                                            # encryption + blind index (32+ random chars).
#                                                            # Keep ONLY in a secrets manager; rotating it
#                                                            # re-keys all encrypted fields. Never commit it.
