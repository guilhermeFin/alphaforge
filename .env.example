# AlphaForge environment variables.
# Copy to `.env` (which is gitignored) and fill in. NEVER commit real secrets —
# the security workflow scans every push for leaked keys and will fail the build.

# --- LLM signal extraction (optional; offline paths work without it) ---
ANTHROPIC_API_KEY=

# Hugging Face financial text features (optional; install alphaforge[llm])
# Use a read-only token. The local .env file is ignored by Git.
HF_TOKEN=
HF_MODEL=ProsusAI/finbert
ALPHAFORGE_TEXT_CACHE_PATH=cache/text_features

# --- model-time integrity (optional; conservative defaults apply unset) ---
# Document studies check whether the scoring model itself existed when the
# document did. ProsusAI/finbert is registered from primary sources; see
# docs/model_time_integrity.md. Anything set here is recorded and displayed as
# an ASSUMPTION, never as a documented fact.
#
# Correct or add a model's dates (JSON; malformed input is ignored, not guessed).
# Applied per field: the example below overrides only the availability date and
# leaves the registered training-data cutoff — and its overlap-risk flagging —
# intact.
# ALPHAFORGE_MODEL_TIME_OVERRIDES={"ProsusAI/finbert":{"model_available_at":"2019-10-30","rationale":"Local weights mirrored from GitHub."}}
#
# Dates for models that are not in the registry. Leave unset to have every
# observation reported as missing model metadata rather than assumed valid.
# ALPHAFORGE_MODEL_TIME_FALLBACK_AVAILABLE_AT=
# ALPHAFORGE_MODEL_TIME_FALLBACK_TRAINING_CUTOFF=

# --- Free point-in-time public data (optional) ---
# SEC EDGAR has no API key. Identify the app and a monitored contact address.
SEC_USER_AGENT=AlphaForge research contact@example.com
# FRED/ALFRED uses all historical vintages to prevent revision leakage.
FRED_API_KEY=

# --- paid point-in-time fundamental data (optional, key-gated) ---
NASDAQ_DATA_LINK_API_KEY=
SIMFIN_API_KEY=

# --- customer-licensed research data (optional, local only) ---
# A local folder with manifest.json, prices.csv, optional universe.csv, and
# optional fundamentals.csv. See docs/licensed_data_bundle.md for the audited schema.
# ALPHAFORGE_LICENSED_DATA_PATH=C:\path\to\licensed-data-bundle

# --- app / API wiring ---
ALPHAFORGE_API=http://127.0.0.1:8000
# Saved research runs stay local by default. The path is ignored by Git.
ALPHAFORGE_HISTORY_PATH=data/alphaforge-workspace.db

# --- security (set in production / behind HTTPS) ---
# ALPHAFORGE_ENV=production                                  # enables Secure cookies + HSTS
# ALPHAFORGE_CORS_ORIGINS=https://app.alphaforge.example     # comma-separated allowed browser origins
# ALPHAFORGE_RATE_LIMIT=120                                  # requests/60s/IP (in-process backstop only)
# ALPHAFORGE_MAX_BODY_BYTES=262144                           # max request body in bytes (default 256 KiB)

# --- accounts / data layer (optional; OFF unless enabled) ---
# ALPHAFORGE_ACCOUNTS=1                                      # turn on the accounts/auth surface
# ALPHAFORGE_DB_PATH=alphaforge.db                           # SQLite path (also enables accounts if set)
# ALPHAFORGE_DATA_KEY=                                       # REQUIRED in prod: master key for field
#                                                            # encryption + blind index (32+ random chars).
#                                                            # Keep ONLY in a secrets manager; rotating it
#                                                            # re-keys all encrypted fields. Never commit it.
